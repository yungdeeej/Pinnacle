# THE SYNDICATE — Environment variables
# Copy to .env.local and fill in your keys. The system runs without these
# (deterministic fallback agents) but Reader/CEO/Wolfman use Claude when set.

# Required for LLM agents (Reader, CEO, Wolfman). Omit to use deterministic fallbacks.
ANTHROPIC_API_KEY=

# Required for live odds. Omit to use seeded mock odds.
ODDS_API_KEY=

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Operator settings
OPERATOR_TIMEZONE=America/Edmonton
SYSTEM_ENV=paper_trade
